# ---------------------------------------------------------------------------
# TelegramMediaManager — OPTIONAL infrastructure overrides.
#
# You do NOT need this file for normal use. All user configuration (Telegram API
# credentials, proxy, bot, folders) is done in the web panel on first run.
# These variables only tune how the container wires up to its surroundings.
# ---------------------------------------------------------------------------

# Where all state lives (SQLite, sessions, mihomo config). Bind-mount this.
# TMM_DATA_DIR=/data

# Default download directory. On a NAS, bind-mount this to a share.
# TMM_DOWNLOADS_DIR=/downloads

# Web panel bind address / port (inside the container).
# TMM_HOST=0.0.0.0
# TMM_PORT=8080

# Set to 1 when serving the panel over HTTPS (adds Secure flag to the cookie).
# TMM_SECURE_COOKIE=0

# Session lifetime in seconds (default 7 days).
# TMM_SESSION_TTL=604800

# --- mihomo (Clash Meta) sidecar ---
# TMM_MIHOMO_ENABLED=1
# TMM_MIHOMO_CONTROLLER=http://mihomo:9090
# TMM_MIHOMO_HOST=mihomo
# TMM_MIHOMO_PORT=7890
# A shared secret for the mihomo REST API (set the same value on both services).
# TMM_MIHOMO_SECRET=change-me
